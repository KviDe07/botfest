# Telegram Bot (обязательно)
BOT_TOKEN=your_bot_token_here

# Telegram ID администраторов через запятую
ADMIN_IDS=601800743

# PostgreSQL (async URL для бота и API)
DATABASE_URL=postgresql+asyncpg://botfest:botfest@localhost:5432/botfest

# Час напоминаний по Москве (0–23)
REMINDER_HOUR_MSK=10

# Админ-панель (FastAPI)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_JWT_SECRET=change-me-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Старые пути JSON (только для скрипта migrate_json_to_pg.py)
